<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1LIFE System - รายการ X-ray ที่นำเข้า</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="brand-section">
        <button class="menu-toggle-btn" aria-label="Toggle Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="brand-title">
          <span class="brand-badge">i</span>
          <span class="brand-text">LIFE</span>
          <span class="brand-sub">System</span>
        </div>
      </div>

      <ul class="nav-menu">
        <li>
          <a href="#" class="nav-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>Dashboard</span>
          </a>
        </li>
        <li>
          <a href="#" class="nav-link nav-link-dropdown">
            <div class="nav-link-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>รายการ X-ray</span>
            </div>
            <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
          </a>
          <ul class="sub-menu">
            <li><a href="#" class="sub-link active">รายการ X-ray ที่นำเข้า</a></li>
            <li><a href="#" class="sub-link">รายการ รอ X-ray</a></li>
          </ul>
        </li>
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-wrapper">
      <!-- Topbar -->
      <header class="topbar">
        <div class="service-selector">
          <div class="service-icon">+</div>
          <span>หน่วยบริการ A</span>
        </div>

        <div class="topbar-right">
          <button class="notification-btn" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span class="notification-badge"></span>
          </button>
          <div class="user-profile">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=faces" alt="Avatar" class="user-avatar">
            <div class="user-info">
              <span class="user-name">นายพัชรนัส จิตภักดี</span>
              <span class="user-role">เจ้าหน้าที่รังสี</span>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
      </header>

      <!-- Body Content -->
      <section class="content-area">
        <!-- Title and Action Button -->
        <div class="page-header">
          <h1 class="page-title">รายการ <span>X-ray</span> ที่นำเข้า</h1>
          <button class="btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>อัปโหลดไฟล์ X-ray</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>

        <!-- Filter Tabs -->
        <div class="tabs-row">
          <div class="tab-item active">
            <span>รายการ X-ray สมอง</span>
            <span class="tab-badge">85</span>
          </div>
          <div class="tab-item">
            <span>รายการ X-ray ทรวงอก</span>
            <span class="tab-badge">120</span>
          </div>
          <div class="tab-item">
            <span>รายการ X-ray ดวงตา</span>
            <span class="tab-badge">25</span>
          </div>
        </div>

        <!-- Stat Cards -->
        <div class="stats-grid">
          <div class="stat-card active-card">
            <div class="stat-left">
              <div class="stat-icon pink">🧠</div>
              <span class="stat-label">รายการทั้งหมด</span>
            </div>
            <div class="stat-number text-blue">85 <span class="stat-unit">เคส</span></div>
          </div>
          <div class="stat-card">
            <div class="stat-left">
              <div class="stat-icon yellow">⏳</div>
              <span class="stat-label">รอยืนยันผล</span>
            </div>
            <div class="stat-number text-amber">40 <span class="stat-unit">เคส</span></div>
          </div>
          <div class="stat-card">
            <div class="stat-left">
              <div class="stat-icon green">📋</div>
              <span class="stat-label">ยืนยันผลวินิจฉัย</span>
            </div>
            <div class="stat-number text-emerald">45 <span class="stat-unit">เคส</span></div>
          </div>
        </div>

        <!-- Filter & Search Controls -->
        <div class="filter-row">
          <div class="filter-left">
            <div class="search-input-wrapper">
              <input type="text" placeholder="ค้นหา" class="search-input">
              <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <div class="select-filter">
              <span style="color:#94a3b8;">ความเร่งด่วนของเคส:</span>
              <span style="font-weight: 500;">ทั้งหมด</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <button class="btn-outline btn-filter-custom">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              <span>ตัวกรองขั้นสูง</span>
            </button>
          </div>
          <button class="btn-outline">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Export</span>
          </button>
        </div>

        <!-- Fixed Non-Responsive Data Table -->
        <div class="table-card">
          <table class="fixed-table">
            <thead>
              <tr>
                <th>เลขที่รายการ ⓘ</th>
                <th>ชื่อผู้ป่วย</th>
                <th>H/N</th>
                <th>ประเภท X-ray</th>
                <th>สถานะรายการ</th>
                <th>ผลลัพธ์ ⓘ</th>
                <th>วันที่ X-ray</th>
                <th>จัดการ</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>*A123456</td>
                <td>THANYANATTHA TH...</td>
                <td>H/N</td>
                <td>X-ray , 2D</td>
                <td><span class="badge-status badge-warning">● รอยืนยันผล</span></td>
                <td><span class="result-tag"><span class="dot-indicator"></span>ไม่พบโรค</span></td>
                <td>04/03/2567 10:00</td>
                <td><a href="#" class="btn-detail">👁 รายละเอียด</a></td>
              </tr>
              <tr>
                <td>*A123456</td>
                <td>THANYANATTHA TH...</td>
                <td>H/N</td>
                <td>MRI , 3D</td>
                <td><span class="badge-status badge-success">✓ ยืนยันผลแล้ว</span></td>
                <td><span class="result-tag"><span class="dot-indicator"></span>ไม่พบโรค</span></td>
                <td>04/03/2567 10:00</td>
                <td><a href="#" class="btn-detail">👁 รายละเอียด</a></td>
              </tr>
              <tr>
                <td>*A123456</td>
                <td>THANYANATTHA TH...</td>
                <td>H/N</td>
                <td>CT Scan , 2D</td>
                <td><span class="badge-status badge-success">✓ ยืนยันผลแล้ว</span></td>
                <td><span class="result-tag"><span class="dot-indicator"></span>ไม่พบโรค</span></td>
                <td>04/03/2567 10:00</td>
                <td><a href="#" class="btn-detail">👁 รายละเอียด</a></td>
              </tr>
              <tr>
                <td>A123456</td>
                <td>THANYANATTHA TH...</td>
                <td>H/N</td>
                <td>CT Scan , 3D</td>
                <td><span class="badge-status badge-warning">● รอยืนยันผล</span></td>
                <td><span class="result-tag"><span class="dot-indicator"></span>ไม่พบโรค</span></td>
                <td>04/03/2567 10:00</td>
                <td><a href="#" class="btn-detail">👁 รายละเอียด</a></td>
              </tr>
              <tr>
                <td>A123456</td>
                <td>THANYANATTHA TH...</td>
                <td>H/N</td>
                <td>MRI , 3D</td>
                <td><span class="badge-status badge-warning">● รอยืนยันผล</span></td>
                <td><span class="result-tag"><span class="dot-indicator"></span>ไม่พบโรค</span></td>
                <td>04/03/2567 10:00</td>
                <td><a href="#" class="btn-detail">👁 รายละเอียด</a></td>
              </tr>
              <tr>
                <td>A123456</td>
                <td>THANYANATTHA TH...</td>
                <td>H/N</td>
                <td>X-ray , 2D</td>
                <td><span class="badge-status badge-success">✓ ยืนยันผลแล้ว</span></td>
                <td><span class="result-tag"><span class="dot-indicator"></span>ไม่พบโรค</span></td>
                <td>04/03/2567 10:00</td>
                <td><a href="#" class="btn-detail">👁 รายละเอียด</a></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="pagination-row">
          <div>
            <span>แสดงทั้งหมด </span>
            <select style="border: 1px solid var(--border-color); border-radius: 4px; padding: 2px 6px; font-family: inherit;">
              <option>10 / page</option>
              <option>20 / page</option>
            </select>
          </div>
          <div class="page-controls">
            <button class="page-btn">Prev</button>
            <button class="page-number active">1</button>
            <button class="page-number">2</button>
            <button class="page-btn">Next</button>
          </div>
        </div>
      </section>
    </main>
  </div>

</body>
</html>